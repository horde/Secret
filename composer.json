{
    "minimum-stability": "dev",
    "name": "horde/secret",
    "description": "Secret key encryption library with authenticated encryption (Libsodium XSalsa20-Poly1305, AES-256-GCM) and legacy Blowfish support",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Secret",
    "license": "LGPL-2.1-only",
    "keywords": ["encryption", "secret", "horde", "libsodium", "aes-gcm", "authenticated-encryption", "aead"],
    "authors": [
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "time": "2022-11-04",
    "repositories": [
        {
            "type": "composer",
            "url": "https://horde-satis.maintaina.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "horde/crypt_blowfish": "^2 || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "ext-hash": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-sodium": "For modern XSalsa20-Poly1305 authenticated encryption (recommended, bundled with PHP 7.2+)",
        "ext-openssl": "For AES-256-GCM authenticated encryption fallback",
        "horde/test": "^3 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "psr-0": {
            "Horde_Secret": "lib/"
        },
        "psr-4": {
            "Horde\\Secret\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Secret\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    }
}