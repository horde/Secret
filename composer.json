{
    "name": "horde/secret",
    "description": "Secret key encryption library with authenticated encryption",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Secret",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "time": "2026-03-07",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/crypt_blowfish": "^2 || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "ext-hash": "*"
    },
    "require-dev": {},
    "suggest": {
        "horde/test": "^3 || dev-FRAMEWORK_6_0",
        "ext-sodium": "*",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-0": {
            "Horde_Secret": "lib/"
        },
        "psr-4": {
            "Horde\\Secret\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Secret\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}